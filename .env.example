# Coffee Ordering Tool - Environment Variables
# Copy this file to .env and fill in your credentials

# Default Roaster
ROASTER=doubleshot

# DoubleShot.cz Credentials
DOUBLESHOT_USERNAME=your_email@example.com
DOUBLESHOT_PASSWORD=your_password

# Dos Mundos Credentials
DOSMUNDOS_USERNAME=your_email@example.com
DOSMUNDOS_PASSWORD=your_password

