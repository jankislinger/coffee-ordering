# Coffee Ordering Tool - Environment Variables
# Copy this file to .env and fill in your credentials

# DoubleShot.cz Credentials
DOUBLESHOT_USERNAME=your_email@example.com
DOUBLESHOT_PASSWORD=your_password

# LLM Configuration (for product matching)
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
# Or use Anthropic:
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Default Roaster
COFFEE_ROASTER=doubleshot

# Cache Settings
CACHE_ENABLED=true
CACHE_TTL=3600

